{
  "name": "feelium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "icons": "node scripts/generate-pwa-icons.mjs && node scripts/generate-splash.mjs",
    "cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --strict-vars=false --env-file .dev.vars.example",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "tsx --test tests/*.unit.test.ts worker/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "rm -f .data/local.db .data/local.db-shm .data/local.db-wal && drizzle-kit migrate",
    "test:data-operations": "tsx --test tests/undo.integration.test.ts tests/outcomes.integration.test.ts tests/review-findings.integration.test.ts tests/push-subscriptions.integration.test.ts tests/sessions.integration.test.ts",
    "test:categories": "tsx --test tests/categories.integration.test.ts",
    "test:e2e": "playwright test",
    "test:migrations": "tsx --test tests/migrations.integration.test.ts",
    "test:persistence": "tsx tests/checkin-persistence.test.ts",
    "test:persistence:local": "bash scripts/test-persistence-local.sh",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@libsql/client": "^0.18.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@sentry/browser": "^11.11.0",
    "@sentry/cloudflare": "^11.11.0",
    "@sentry/core": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "get-nonce": "1.0.1",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "release-kit": "github:n8watkins/release-kit#v2.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    },
    "next": {
      "postcss": "8.5.32"
    },
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
