{
  "$schema": "node_modules/wrangler/config-schema.json",
  // feelium on Cloudflare Workers: the Next.js app built with OpenNext
  // (`npm run build:worker`), plus the reminder Cron Trigger in worker/handlers.ts.
  "name": "feelium",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat is required by @opennextjs/cloudflare, and web-push uses node:crypto and node:https.
  "compatibility_flags": ["nodejs_compat"],
  // Don't wrap functions in esbuild's __name() helper. next-themes stringifies its
  // theme function into an inline script, and __name doesn't exist in the browser, so the
  // theme failed to apply before first paint (dark mode flashed light).
  "keep_names": false,
  // Served at https://feelium.n8builds.dev (a custom domain attached to this
  // Worker in the dashboard). The workers.dev address is off, so all traffic
  // goes through the zone (bot rules, cache).
  "workers_dev": false,
  // Version preview URLs would run with this Worker's secrets, so a preview would
  // read and write the production database. Keep them off.
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers Cache (worker/edge-cache.ts): Cloudflare's cache sits in front of the
  // CachedPages entrypoint, so the landing page, share images and icons cost no CPU
  // time once cached. The default entrypoint runs on every request and sends only
  // those to CachedPages.
  "cache": { "enabled": false },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "CachedPages": { "type": "worker", "cache": { "enabled": true } }
  },
  // The cron calls the reminder code directly (worker/handlers.ts); "server-only"
  // only guards against client bundles, which this Worker entry is not.
  "alias": { "server-only": "./worker/server-only.ts" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Every five minutes, offset by two: /api/notifications/send pushes the
  // reminders that are due.
  "triggers": {
    "crons": ["2-57/5 * * * *"]
  },
  "vars": {
    // src/lib/app-env.ts: a deployment fails closed without Turso.
    "APP_ENV": "production",
    // The canonical origin: Auth.js builds its callback URLs from it.
    "AUTH_URL": "https://feelium.n8builds.dev",
    "VAPID_SUBJECT": "mailto:nathancwatkins23@gmail.com"
  }
  // Secrets are set with `wrangler secret put <NAME>`, never in this file.
  // Optional ones switch features on: SENTRY_DSN (error reporting, src/lib/error-reporting.ts)
  // and CF_WEB_ANALYTICS_TOKEN (Cloudflare Web Analytics for feelium.n8builds.dev,
  // src/components/web-analytics.tsx).
  // .dev.vars.example lists them (and generates their binding types); local
  // workerd runs read real values from .dev.vars.
}
