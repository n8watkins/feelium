# Copy this file to `.env.local` and fill in the values. Everything here is LOCAL only -
# no cloud services, no real secrets.

# Local libSQL/SQLite database file. Created by `npm run db:migrate`.
DATABASE_URL=file:./.data/local.db

# Auth.js session-encryption secret. Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 33
AUTH_SECRET=generate-your-own-local-secret

# Base URL of the app (used by Auth.js for callback URLs).
AUTH_URL=http://localhost:3000

# --- Web Push / Notifications (Phase 6) ---
# Generate a VAPID key pair with:  npx web-push generate-vapid-keys
# The PUBLIC key is exposed to the browser (NEXT_PUBLIC_ prefix) and used to subscribe.
# The PRIVATE key MUST stay server-side and secret - it signs push messages.
# In production, set all three as environment variables (e.g. Vercel Project Settings).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI push services can reach (mailto: or https:). Used as the VAPID subject.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret guarding the reminder-send endpoint (POST /api/notifications/send).
# In production a scheduled trigger (e.g. Vercel Cron) calls that endpoint every minute
# with this value as an "Authorization: Bearer <CRON_SECRET>" header.
CRON_SECRET=generate-a-long-random-string
