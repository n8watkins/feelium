# Copy this file to `.env.local` and fill in the values.
#
# These are LOCAL Supabase values only - printed by `npx supabase start` (and shown
# again by `npx supabase status`). Local Supabase uses fixed, non-secret demo keys, so
# there is nothing sensitive here. Never put a cloud project URL or a real service_role
# key in this repo.

# Local Supabase API URL (default port 54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local anon (public) key from `supabase start` output.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
