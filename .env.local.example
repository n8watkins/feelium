# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored - never commit real secrets.

# ---------------------------------------------------------------------------
# Local development (required)
# ---------------------------------------------------------------------------

# Local libSQL/SQLite database file. Created by `npm run db:migrate`.
DATABASE_URL=file:./.data/local.db

# Auth.js session-encryption secret (required). Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 33
AUTH_SECRET=generate-your-own-local-secret

# Base URL of the app, used by Auth.js for callback URLs.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# GitHub OAuth (REQUIRED - the only sign-in method, locally and in prod)
# Create an OAuth App: https://github.com/settings/developers
# Dev Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Without these you cannot sign in at all: "Continue with GitHub" is the only
# provider (email sign-in was removed - see ADR-002 in docs/DEVIATIONS.md).
# ---------------------------------------------------------------------------
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# ---------------------------------------------------------------------------
# Cloud Turso database (production only)
# When both are set they take precedence over DATABASE_URL.
# Run migrations against it with:
#   TURSO_DATABASE_URL=... TURSO_AUTH_TOKEN=... npm run db:migrate
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ---------------------------------------------------------------------------
# Web Push / Notifications (Phase 6)
# Generate a VAPID key pair with:  npx web-push generate-vapid-keys
# The PUBLIC key is handed to the browser and used to subscribe.
# The PRIVATE key MUST stay server-side and secret - it signs push messages.
# In production, set them as Worker secrets (see .dev.vars.example).
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI push services can reach (mailto: or https:). Used as the VAPID subject.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret guarding the reminder-send endpoint (POST /api/notifications/send).
# In production the committed GitHub Actions workflow calls that endpoint every five
# minutes with this value as an "Authorization: Bearer <CRON_SECRET>" header.
CRON_SECRET=generate-a-long-random-string
