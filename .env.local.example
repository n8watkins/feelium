# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored - never commit real secrets.

# ---------------------------------------------------------------------------
# Local development (required)
# ---------------------------------------------------------------------------

# Local libSQL/SQLite database file. Created by `npm run db:migrate`.
DATABASE_URL=file:./.data/local.db

# Auth.js session-encryption secret (required). Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 33
AUTH_SECRET=generate-your-own-local-secret

# Base URL of the app, used by Auth.js for callback URLs.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# GitHub OAuth (optional locally, required in production)
# Create an OAuth App: https://github.com/settings/developers
# Dev Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Without these the "Continue with GitHub" button errors, but magic-link and
# password sign-in still work.
# ---------------------------------------------------------------------------
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# ---------------------------------------------------------------------------
# Email magic link
# Development prints the sign-in link to the server console - no key needed.
# Production sends real email via Resend (requires AUTH_RESEND_KEY).
# ---------------------------------------------------------------------------
# AUTH_RESEND_KEY=your-resend-api-key
# From address for magic-link emails. Production requires a verified Resend
# sender domain. Defaults to "feelium <onboarding@resend.dev>" if unset.
# AUTH_EMAIL_FROM=feelium <no-reply@yourdomain.com>

# ---------------------------------------------------------------------------
# Cloud Turso database (production only)
# When both are set they take precedence over DATABASE_URL.
# Run migrations against it with:
#   TURSO_DATABASE_URL=... TURSO_AUTH_TOKEN=... npm run db:migrate
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ---------------------------------------------------------------------------
# Web Push / Notifications (Phase 6)
# Generate a VAPID key pair with:  npx web-push generate-vapid-keys
# The PUBLIC key is exposed to the browser (NEXT_PUBLIC_ prefix) and used to subscribe.
# The PRIVATE key MUST stay server-side and secret - it signs push messages.
# In production, set all three as environment variables (e.g. Vercel Project Settings).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI push services can reach (mailto: or https:). Used as the VAPID subject.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret guarding the reminder-send endpoint (POST /api/notifications/send).
# In production a scheduled trigger (e.g. Vercel Cron) calls that endpoint every minute
# with this value as an "Authorization: Bearer <CRON_SECRET>" header.
CRON_SECRET=generate-a-long-random-string
